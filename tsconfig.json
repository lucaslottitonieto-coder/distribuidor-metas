{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "noEmit": true,
    "baseUrl": ".", "paths": { "broto-ui": ["vendor/broto-ui/src/index.ts"] },
    "types": ["vite/client", "node"]
  },
  "include": ["frontend/src", "vite.config.ts"]
}
