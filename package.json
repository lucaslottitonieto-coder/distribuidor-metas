{
  "name": "sicredi-distribuidor-metas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api": ".venv\\Scripts\\python.exe -m uvicorn backend.main:app --host 127.0.0.1 --port 8765",
    "test:api": ".venv\\Scripts\\python.exe -m unittest discover -s backend/tests -v",
    "test:math": "node --test frontend/tests/math.test.mjs frontend/tests/matrix.test.mjs frontend/tests/columns.test.mjs frontend/tests/export.test.mjs frontend/tests/numeric-input.test.mjs",
    "start": "node scripts/start.mjs",
    "start:production": "node scripts/start.mjs --production"
  },
  "dependencies": {
    "@fontsource-variable/exo-2": "^5.2.8",
    "@fontsource-variable/nunito": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  }
}
